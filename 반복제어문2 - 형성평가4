#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    int n;
    int num, sum = 0;
    double avg;

    cin >> n;

    for (int i = 0; i < n; i++) {
        cin >> num;
        sum += num;
    }

    avg = (double)sum / n;

    cout << fixed << setprecision(2) << avg << '\n';

    return 0;
}
