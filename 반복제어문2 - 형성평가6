#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    int a, b;
    int sum = 0, count = 0;

    cin >> a >> b;

    if (a > b) {
        int temp = a;
        a = b;
        b = temp;
    }

    for (int i = a; i <= b; i++) {
        if (i % 3 == 0 || i % 5 == 0) {
            sum += i;
            count++;
        }
    }

    double avg = (double)sum / count;

    cout << "sum : " << sum << '\n';
    cout << "avg : " << fixed << setprecision(1) << avg << '\n';

    return 0;
}
