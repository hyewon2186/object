#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    char ch = 'A';
    int num = 0;

    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n - i + 1; j++) {
            cout << ch++ << " ";
        }

        for (int j = 1; j < i; j++) {
            cout << num++;
            if (j < i - 1) cout << " ";
        }

        cout << '\n';
    }

    return 0;
}
