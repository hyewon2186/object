#include <iostream>
using namespace std;

int main() {
    int arr[100];
    int n = 0;

    while (n < 100) {
        cin >> arr[n];

        if (arr[n] == 0) {
            break;
        }

        n++;
    }

    cout << n << endl;

    for (int i = 0; i < n; i++) {
        if (arr[i] % 2 == 1) {
            cout << arr[i] * 2;
        } else {
            cout << arr[i] / 2;
        }

        cout << " ";
    }

    return 0;
}
