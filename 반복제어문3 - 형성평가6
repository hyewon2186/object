#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int num = 1;

    for (int i = 1; i <= n; i++) {
        for (int s = 1; s < i; s++) {
            cout << "  ";
        }

        for (int j = i; j <= n; j++) {
            cout << num++;

            if (j < n) {
                cout << " ";
            }
        }

        cout << '\n';
    }

    return 0;
}
