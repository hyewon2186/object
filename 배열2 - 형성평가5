#include <iostream>
using namespace std;

int main() {
    int arr[4][3];
    int total = 0;

    for (int i = 0; i < 4; i++) {
        int sum = 0;

        for (int j = 0; j < 3; j++) {
            cin >> arr[i][j];
            sum += arr[i][j];
        }

        cout << sum << endl;
        total += sum;
    }

    cout << total << endl;

    return 0;
}
