#include <iostream>
using namespace std;

int main() {
    int num;
    int max, min;
    int first = 1;

    while (true) {
        cin >> num;

        if (num == 0) {
            break;
        }

        if (first == 1) {
            max = num;
            min = num;
            first = 0;
        } else {
            if (num > max) {
                max = num;
            }

            if (num < min) {
                min = num;
            }
        }
    }

    cout << max + min;

    return 0;
}
