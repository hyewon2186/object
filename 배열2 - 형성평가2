#include <iostream>
using namespace std;

int main() {
    int arr[11] = {0};
    int num;

    while (true) {
        cin >> num;

        if (num == 0) {
            break;
        }

        arr[num / 10]++;
    }

    for (int i = 10; i >= 0; i--) {
        if (arr[i] > 0) {
            cout << i * 10 << " : " << arr[i] << endl;
        }
    }

    return 0;
}
