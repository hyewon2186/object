#include <iostream>
using namespace std;

int main() {
    int arr[10];
    int odd = 0;
    int even = 0;

    for (int i = 0; i < 10; i++) {
        cin >> arr[i];

        if ((i + 1) % 2 == 1) {
            odd += arr[i];
        } else {
            even += arr[i];
        }
    }

    cout << "odd : " << odd << endl;
    cout << "even : " << even << endl;

    return 0;
}
