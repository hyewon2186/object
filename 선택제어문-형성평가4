#include <iostream>
using namespace std;

int main() {
    int num;
    cin >> num;

    switch (num) {
        case 1:
            cout << "dog" << endl;
            break;
        case 2:
            cout << "cat" << endl;
            break;
        case 3:
            cout << "chick" << endl;
            break;
        default:
            cout << "blank" << endl;
            break;
    }
    return 0;
}
