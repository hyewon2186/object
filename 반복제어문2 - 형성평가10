#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    int a, b;
    cin >> a >> b;

    int step = (a <= b) ? 1 : -1;

    for (int i = 1; i <= 9; i++) {
        for (int j = a; ; j += step) {
            cout << j << " * " << i << " = "
                 << setw(2) << j * i;

            if (j == b) {
                break;
            }

            cout << "   ";
        }
        cout << '\n';
    }

    return 0;
}
