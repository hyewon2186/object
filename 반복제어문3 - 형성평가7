#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= i; j++) {
            if (j > 1) cout << " ";
            cout << "#";
        }
        cout << endl;
    }

    for (int i = 1; i < n; i++) {
        for (int s = 1; s <= i; s++) {
            cout << " ";
        }

        for (int j = 1; j <= n - i; j++) {
            if (j > 1) cout << " ";
            cout << "#";
        }
        cout << endl;
    }

    return 0;
}
